# ORMEN Atelier ortam değişkenleri. Bu dosyayı .env.local adıyla kopyalayın.
# Hiçbiri zorunlu değil: boşken uygulama örnek veriyle çalışır.

# Sitenin gerçek adresi (paylaşım önizlemeleri ve QR kodları bu adresi kullanır).
# Boşsa Vercel'in verdiği adres kullanılır.
NEXT_PUBLIC_SITE_URL=

# Numune talebinde "WhatsApp'tan da gönder" düğmesinin gideceği ORMEN numarası.
# Firma sayfalarında firmanın kendi numarası kullanılır. Örnek: +90 5xx xxx xx xx
NEXT_PUBLIC_ORMEN_WHATSAPP=

# Supabase: kumaşlar, modeller ve numune talepleri burada kalıcı olarak tutulur.
# README'deki "Supabase kurulumu" adımlarına bakın. Service role anahtarı gizlidir;
# yalnızca Vercel'e ve .env.local'e yazılır, kimseyle paylaşılmaz.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase YOKKEN panele girmek için tek kullanıcı (deneme amaçlı).
# Geliştirme ortamında boşsa demo@ormen.local / ormen-demo kullanılır.
# Bu modda eklenenler sunucu yeniden başlayınca kaybolur.
PANEL_DEMO_EMAIL=
PANEL_DEMO_PASSWORD=
# Demo oturum çerezini imzalamak için en az 32 karakterlik rastgele bir metin.
# Üretimde (Vercel) zorunlu: yoksa demo girişi kapalı kalır.
PANEL_SESSION_SECRET=
