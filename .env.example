# ORMEN Atelier ortam değişkenleri. Bu dosyayı .env.local adıyla kopyalayın.
# Hiçbiri zorunlu değil: boşken uygulama örnek veriyle çalışır.

# Sitenin gerçek adresi (paylaşım önizlemeleri ve QR kodları bu adresi kullanır).
# Boşsa Vercel'in verdiği adres kullanılır.
NEXT_PUBLIC_SITE_URL=

# Numune talebinde "WhatsApp'tan da gönder" düğmesinin gideceği ORMEN numarası.
# Firma sayfalarında firmanın kendi numarası kullanılır. Örnek: +90 5xx xxx xx xx
NEXT_PUBLIC_ORMEN_WHATSAPP=

# Supabase (panel diliminde kullanılacak)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
